// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Question {
  id          String   @id @default(cuid())
  subject     String   // e.g., s5 or Bahasa Inggris
  grade       String   // e.g., c1 or Kelas VII
  topic       String   // e.g., Tenses
  difficulty  String   // mudah, sedang, sulit
  type        String   // pilihan_ganda, essay, dll
  
  // Storing the full JSON payload generated by AI
  // This allows flexibility for different question types (options, matching pairs, etc.)
  content     Json     

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Keep User model for future auth
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuestionBank {
  id            String   @id @default(cuid())
  name          String
  description   String?
  subjectId     String
  classGradeId  String
  topicId       String
  questionCount Int      @default(0)
  questions     Json     // Store array of questions temporarily or map properly. Wait, since questions are in Question model, we can map them.
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Exam {
  id              String   @id @default(cuid())
  title           String
  description     String?
  subjectId       String
  classGradeId    String
  status          String   // draft, published, active, completed
  durationMinutes Int
  totalPoints     Int
  passingScore    Int
  token           String
  questions       ExamQuestion[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ExamQuestion {
  id         String   @id @default(cuid())
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionId String
  order      Int
  points     Int
}

model Student {
  id         String   @id @default(cuid())
  name       String
  classGrade String
  avatar     String?
  sessions   StudentExamSession[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model StudentExamSession {
  id                   String   @id @default(cuid())
  studentId            String
  student              Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examId               String
  status               String   // active, disconnected, flagged, completed, auto_submitted, not_started
  antiCheatStrikes     Int      @default(0)
  startTime            DateTime?
  endTime              DateTime?
  currentQuestionIndex Int      @default(0)
  answers              Json     // Store StudentAnswer[]
  score                Int?
  alerts               Json?    // Store AntiCheatAlert[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}